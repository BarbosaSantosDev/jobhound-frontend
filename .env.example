# Desenvolvimento (npm start): o dev server faz proxy de /api para o backend,
# então não há CORS. Aponte para onde a API do jobhound está rodando.
# Padrão: http://localhost:8000 (porta padrão do docker compose do backend).
JOBHOUND_API_PROXY=http://localhost:8000

# Build de produção servido num host diferente da API: URL absoluta do backend.
# Deixe vazio para usar a mesma origem (ex.: atrás de um reverse proxy).
# (create-react-app só expõe ao navegador env vars prefixadas com REACT_APP_.)
REACT_APP_API_URL=
